{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/multidisciplinary-book-publish",
      "destination": "https://multidisciplinary-book-publish.vercel.app"
    },
    {
      "source": "/multidisciplinary-book-publish/",
      "destination": "https://multidisciplinary-book-publish.vercel.app"
    },
    {
      "source": "/multidisciplinary-book-publish/:path*",
      "destination": "https://multidisciplinary-book-publish.vercel.app/:path*"
    },
    {
      "source": "/cssa",
      "destination": "https://cscpduama.github.io/CSSA/index.html"
    },
    {
      "source": "/cssa/",
      "destination": "https://cscpduama.github.io/CSSA/index.html"
    },
    {
      "source": "/cssa/:path",
      "destination": "https://cscpduama.github.io/CSSA/:path.html"
    },
    {
      "source": "/cssa/:path*",
      "destination": "https://cscpduama.github.io/CSSA/:path*"
    }
  ]
}