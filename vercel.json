{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:subpath/sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/:subpath/robots.txt",
      "destination": "/robots.txt",
      "permanent": true
    },
    {
      "source": "/cssa",
      "destination": "/cssa/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/multidisciplinary-book-publish",
      "destination": "https://multidisciplinary-book-publish.vercel.app"
    },
    {
      "source": "/multidisciplinary-book-publish/",
      "destination": "https://multidisciplinary-book-publish.vercel.app"
    },
    {
      "source": "/multidisciplinary-book-publish/:path*",
      "destination": "https://multidisciplinary-book-publish.vercel.app/:path*"
    },
    {
      "source": "/cssa/ctf/pduamactf2026",
      "destination": "https://pduama-ctf-2026.onrender.com"
    },
    {
      "source": "/cssa/ctf/pduamactf2026/",
      "destination": "https://pduama-ctf-2026.onrender.com"
    },
    {
      "source": "/cssa/ctf/pduamactf2026/:path*",
      "destination": "https://pduama-ctf-2026.onrender.com/:path*"
    },
    {
      "source": "/themes/:path*",
      "destination": "https://pduama-ctf-2026.onrender.com/themes/:path*"
    },
    {
      "source": "/files/:path*",
      "destination": "https://pduama-ctf-2026.onrender.com/files/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://pduama-ctf-2026.onrender.com/api/v1/:path*"
    },
    {
      "source": "/events",
      "destination": "https://pduama-ctf-2026.onrender.com/events"
    },
    {
      "source": "/cssa/",
      "destination": "https://cscpduama.github.io/cssa/index.html"
    },
    {
      "source": "/cssa/:path.html",
      "destination": "https://cscpduama.github.io/cssa/:path.html"
    },
    {
      "source": "/cssa/:path([^.]+)",
      "destination": "https://cscpduama.github.io/cssa/:path.html"
    },
    {
      "source": "/cssa/:path*",
      "destination": "https://cscpduama.github.io/cssa/:path*"
    },
    {
      "source": "/.../.../.../solve-it-get-it",
      "destination": "/puzzle-gate"
    },
    {
      "source": "/.../.../.../solve-it-get-it/",
      "destination": "/puzzle-gate"
    },
    {
      "source": "/.../.../.../solve-it-get-it/:path*",
      "destination": "/puzzle-gate/:path*"
    },
    {
      "source": "/\\.\\.\\./\\.\\.\\./\\.\\.\\./solve-it-get-it",
      "destination": "/puzzle-gate"
    },
    {
      "source": "/\\.\\.\\./\\.\\.\\./\\.\\.\\./solve-it-get-it/",
      "destination": "/puzzle-gate"
    },
    {
      "source": "/\\.\\.\\./\\.\\.\\./\\.\\.\\./solve-it-get-it/:path*",
      "destination": "/puzzle-gate/:path*"
    }
  ]
}
